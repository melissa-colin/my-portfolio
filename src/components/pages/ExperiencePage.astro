---
import PageLayout from '../../layouts/PageLayout.astro';
import { FiBriefcase, FiExternalLink, FiCalendar, FiMapPin, FiCheckSquare, FiSquare, FiAward, FiX } from 'react-icons/fi';
import { getUI, getList, type Locale } from '../../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = await getUI(locale);
const e = ui.experience ?? {};
const experiences = await getList('experiences', locale);

const pageTitle = e.pageTitle;
const pageSubtitle = e.pageSubtitle ?? '';
const moreInfo = e.moreInfo ?? '';
const noExperienceText = e.noExperience ?? 'No experience available.';

// Unique types in first-seen order (matches Array.from(new Set(...)))
const allTypes = [...new Set(experiences.map((exp: any) => exp.type).filter(Boolean))];

const resetLabel = locale === 'fr' ? 'Réinitialiser' : 'Reset';
---

<PageLayout locale={locale} path="/experience" title={`${pageTitle} | ${ui.home?.heroTitle}`}>
  <div class="pt-24 pb-20">
    {/* Hero Section */}
    <section class="bg-gray-900 dark:bg-black py-16 relative overflow-hidden exp-page">
      <div class="absolute inset-0 bg-opacity-70">
        <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-gray-900 via-transparent to-red-900/20 opacity-80"></div>
      </div>
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="anim-title title-gradient text-4xl md:text-5xl font-bold mb-6 text-white">{pageTitle}</h1>
          <div class="a-bar section-bar mx-auto bg-red-500" style="animation-delay:0.25s"></div>
          <p class="a-fade mt-6 text-xl text-gray-200 max-w-3xl mx-auto" style="animation-delay:0.4s">{pageSubtitle}</p>
        </div>
      </div>
    </section>
    {/* Experience Content */}
    <section class="py-20">
      <div class="container mx-auto px-4">
        {/* Filtres par type */}
        {allTypes.length > 0 && (
          <div class="mb-10 flex flex-wrap gap-4 justify-center" id="exp-filter">
            {allTypes.map((type: string) => (
              <button
                type="button"
                data-type={type}
                class="js-type flex items-center px-4 py-2 rounded-full border transition-colors bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 border-gray-300 dark:border-gray-700 hover:bg-red-100 dark:hover:bg-red-900/30"
                data-active-class="bg-red-500 text-white border-red-500"
                data-idle-class="bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 border-gray-300 dark:border-gray-700 hover:bg-red-100 dark:hover:bg-red-900/30"
              >
                <FiCheckSquare className="mr-2 js-icon-check" />
                <FiSquare className="mr-2 js-icon-square" />
                <span>{type}</span>
              </button>
            ))}
            <button
              type="button"
              id="exp-reset"
              class="ml-2 px-3 py-2 rounded-full bg-gray-200 dark:bg-gray-700 text-gray-600 dark:text-gray-300 border border-gray-300 dark:border-gray-600 hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
              style="display:none"
            >{resetLabel}</button>
          </div>
        )}
        <div id="exp-empty" class="flex justify-center items-center h-64" style="display:none">
          <span class="text-gray-400 text-lg">{noExperienceText}</span>
        </div>
        <div class="space-y-12 max-w-4xl mx-auto" id="exp-list" data-stagger>
          {experiences.map((experience: any, i: number) => (
            <div
              class="js-exp bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden border border-gray-200 dark:border-gray-700 transition-all duration-200 hover:-translate-y-1 hover:shadow-xl"
              class:list={[experience.detail && 'has-detail']}
              data-type={experience.type}
              data-modal={experience.detail ? `xm-${i}` : undefined}
            >
              <div class="md:flex">
                <div class="md:w-1/4 flex flex-col items-center justify-center bg-red-900/10 dark:bg-red-900/20">
                  {experience.companies && experience.companies.length > 1 ? (
                    <div class="logo-stack m-6">
                      {experience.companies.map((c: any, i: number) => (
                        <a
                          class="logo-chip"
                          href={c.url || undefined}
                          target={c.url ? '_blank' : undefined}
                          rel={c.url ? 'noopener noreferrer' : undefined}
                          style={`z-index:${experience.companies.length - i}`}
                          title={c.name}
                          aria-label={c.name}
                        >
                          <span class="logo-initial">{c.name.charAt(0)}</span>
                          <img src={c.logo} alt={c.name} width={44} height={44} loading="lazy" onerror="this.remove()" />
                        </a>
                      ))}
                    </div>
                  ) : (
                  <a
                    class="w-16 h-16 flex items-center justify-center rounded-full bg-red-900/30 text-red-500 m-6 logo-single"
                    href={experience.companyUrl || undefined}
                    target={experience.companyUrl ? '_blank' : undefined}
                    rel={experience.companyUrl ? 'noopener noreferrer' : undefined}
                    aria-label={experience.company}
                    title={experience.company}
                  >
                    {experience.logo ? (
                      <img
                        src={experience.logo.startsWith('/') ? experience.logo : `/${experience.logo}`}
                        alt={experience.company}
                        class="w-16 h-16 flex items-center justify-center rounded-full bg-red-900/30 text-red-500"
                        width={64}
                        height={64}
                        loading="lazy"
                      />
                    ) : (
                      <FiBriefcase size={32} />
                    )}
                  </a>
                  )}
                  <span class="mt-2 text-sm text-gray-600 dark:text-gray-300 text-center">
                    {experience.type}
                  </span>
                </div>
                <div class="md:w-3/4 p-6">
                  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 mb-3">
                    <h3 class="text-2xl font-bold text-gray-900 dark:text-white">{experience.title}</h3>
                    <div class="flex items-center text-sm text-red-500 font-semibold">
                      <FiCalendar className="mr-1" />
                      <span>{experience.period}</span>
                    </div>
                  </div>
                  <div class="flex flex-col md:flex-row md:items-center gap-2 mb-6">
                    <div class="flex items-center flex-wrap text-gray-700 dark:text-gray-300">
                      {experience.companies && experience.companies.length > 1 ? (
                        experience.companies.map((c: any, i: number) => (
                          <>
                            {i > 0 && <span class="mx-2 text-gray-400 dark:text-gray-600">&#215;</span>}
                            {c.url ? (
                              <a href={c.url} target="_blank" rel="noopener noreferrer" class="hover:text-red-500 transition-colors inline-flex items-center">
                                {c.name} <FiExternalLink className="ml-1 text-sm" />
                              </a>
                            ) : (
                              <span>{c.name}</span>
                            )}
                          </>
                        ))
                      ) : experience.companyUrl ? (
                        <a href={experience.companyUrl} target="_blank" rel="noopener noreferrer" class="hover:text-red-500 transition-colors flex items-center">
                          {experience.company} <FiExternalLink className="ml-1 text-sm" />
                        </a>
                      ) : (
                        <span>{experience.company}</span>
                      )}
                    </div>
                    <span class="hidden md:block text-gray-400 dark:text-gray-600">•</span>
                    <div class="flex items-center text-gray-500 dark:text-gray-400 text-sm">
                      <FiMapPin className="mr-1" />
                      <span>{experience.location}</span>
                    </div>
                  </div>
                  {experience.award && (
                    <div class="mb-4">
                      <a
                        class="award-badge"
                        href={experience.awardUrl || undefined}
                        target={experience.awardUrl ? '_blank' : undefined}
                        rel={experience.awardUrl ? 'noopener noreferrer' : undefined}
                      >
                        <FiAward />
                        <span>{experience.award}</span>
                      </a>
                    </div>
                  )}
                  <p class="text-gray-700 dark:text-gray-300 mb-6">{experience.description}</p>
                  {experience.detail && (
                    <button type="button" class="js-more read-more mb-4" data-modal={`xm-${i}`}>
                      {e.readMore ?? 'En savoir plus'} <span aria-hidden="true">&#8594;</span>
                    </button>
                  )}
                  <div class="flex flex-wrap gap-2">
                    {experience.technologies && experience.technologies.map((tech: string) => (
                      <span class="px-3 py-1 bg-gray-200 dark:bg-red-900/20 text-red-600 dark:text-red-400 text-sm rounded-full">
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
        {experiences.map((experience: any, i: number) => experience.detail && (
          <dialog id={`xm-${i}`} class="exp-modal" aria-label={experience.title}>
            <form method="dialog" class="xm-close-wrap">
              <button class="xm-close" aria-label={e.close ?? 'Fermer'}><FiX /></button>
            </form>
            <div class="xm-body">
              <h3>{experience.title}</h3>
              <p class="xm-meta">{experience.company} &#183; {experience.period}</p>
              <div class="xm-detail" set:html={experience.detail} />
            </div>
          </dialog>
        ))}

        <div class="text-center mt-16">
          <p class="text-gray-400 italic">
            {moreInfo}
          </p>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<script is:inline>
  (function () {
    var filter = document.getElementById('exp-filter');
    var list = document.getElementById('exp-list');
    var empty = document.getElementById('exp-empty');
    var cards = Array.prototype.slice.call(document.querySelectorAll('#exp-list .js-exp'));

    // Le detail s'ouvre au clic, dans une fenetre : au survol il sautait sous le curseur.
    function openModal(id) {
      var d = document.getElementById(id);
      if (d && typeof d.showModal === 'function') d.showModal();
    }
    document.querySelectorAll('.js-more').forEach(function (b) {
      b.addEventListener('click', function (ev) { ev.stopPropagation(); openModal(b.getAttribute('data-modal')); });
    });
    cards.forEach(function (c) {
      if (!c.getAttribute('data-modal')) return;
      c.addEventListener('click', function (ev) {
        if (ev.target.closest('a, button')) return;
        openModal(c.getAttribute('data-modal'));
      });
    });
    document.querySelectorAll('dialog.exp-modal').forEach(function (d) {
      d.addEventListener('click', function (ev) { if (ev.target === d) d.close(); });
    });

    if (!filter) return;
    var btns = Array.prototype.slice.call(filter.querySelectorAll('.js-type'));
    var reset = document.getElementById('exp-reset');
    var selected = [];

    function setClasses(el, str) { el.className = 'js-type flex items-center px-4 py-2 rounded-full border transition-colors ' + str; }

    function apply() {
      cards.forEach(function (c) {
        var ok = selected.length === 0 || selected.indexOf(c.getAttribute('data-type')) !== -1;
        c.style.display = ok ? '' : 'none';
      });
      var visible = cards.filter(function (c) { return c.style.display !== 'none'; });
      if (empty) empty.style.display = visible.length === 0 ? '' : 'none';
      btns.forEach(function (b) {
        var active = selected.indexOf(b.getAttribute('data-type')) !== -1;
        setClasses(b, active ? b.getAttribute('data-active-class') : b.getAttribute('data-idle-class'));
        var check = b.querySelector('.js-icon-check');
        var square = b.querySelector('.js-icon-square');
        if (check) check.style.display = active ? '' : 'none';
        if (square) square.style.display = active ? 'none' : '';
      });
      if (reset) reset.style.display = selected.length > 0 ? '' : 'none';
    }

    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        var t = b.getAttribute('data-type');
        var i = selected.indexOf(t);
        if (i === -1) selected.push(t); else selected.splice(i, 1);
        apply();
      });
    });
    if (reset) reset.addEventListener('click', function () { selected = []; apply(); });
    apply();
  })();
</script>

<style>
  .has-detail { cursor: pointer; }
  .read-more {
    background: none; border: 0; padding: 0;
    font-size: 0.875rem; font-weight: 600;
    color: rgb(220 38 38); cursor: pointer;
  }
  .read-more:hover { text-decoration: underline; }

  .exp-modal {
    width: min(680px, calc(100vw - 2rem));
    max-height: 85vh;
    padding: 0; border: 0; border-radius: 0.75rem;
    background: #ffffff; color: #1f2937; overflow: auto;
  }
  :global(.dark) .exp-modal { background: #1f2937; color: #e5e7eb; }
  .exp-modal::backdrop { background: rgb(0 0 0 / 0.65); }
  .xm-body { padding: 1.75rem; }
  .xm-body h3 { font-size: 1.35rem; font-weight: 700; margin-bottom: 0.25rem; }
  .xm-meta { font-size: 0.875rem; opacity: 0.7; margin-bottom: 1.25rem; }
  .xm-detail :global(h4) { font-weight: 700; margin: 1.1rem 0 0.4rem; }
  .xm-detail :global(p) { margin-bottom: 0.85rem; line-height: 1.65; }
  .xm-detail :global(ul) { list-style: disc; padding-left: 1.25rem; margin-bottom: 0.85rem; }
  .xm-detail :global(li) { margin-bottom: 0.3rem; line-height: 1.55; }
  .xm-close-wrap { position: sticky; top: 0; height: 0; text-align: right; z-index: 2; }
  .xm-close {
    margin: 0.6rem; width: 2rem; height: 2rem;
    display: inline-flex; align-items: center; justify-content: center;
    border: 0; border-radius: 9999px; cursor: pointer;
    background: rgb(0 0 0 / 0.55); color: #fff;
  }

  /* Deux employeurs sur une meme experience : les pastilles se chevauchent en
     DIAGONALE (la premiere de `companies` en haut a gauche et devant, ici NAVER
     qui signe la convention ; la seconde en bas a droite).
     Les deux logos sont opaques et ont leur propre fond : la pastille n'a donc
     aucun fond a elle, sinon il deborde en liseré. L'anneau qui separe les deux
     disques prend la couleur de la carte, pas du blanc.
     Au survol, le logo pointe passe de 44 a 64 px, soit la taille qu'il aurait
     seul, en grandissant depuis son propre coin pour rester ancre. */
  .logo-stack {
    position: relative;
    width: 76px;
    height: 76px;
  }
  .logo-chip {
    position: absolute;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    overflow: hidden;
    background: transparent;
    box-shadow: 0 0 0 3px #ffffff;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  :global(.dark) .logo-chip { box-shadow: 0 0 0 3px #1f2937; }

  /* Le premier (celui qui signe) est un peu plus gros et devant. */
  .logo-chip:nth-child(1) { top: 0; left: 0; width: 50px; height: 50px; transform-origin: top left; }
  .logo-chip:nth-child(2) { bottom: 0; right: 0; transform-origin: bottom right; }
  /* Au survol, les deux atteignent 64 px : la taille qu'ils auraient seuls. */
  .logo-chip:nth-child(1):hover { transform: scale(1.28); }
  .logo-chip:nth-child(2):hover { transform: scale(1.4545); }

  .logo-chip img {
    position: relative;   /* passe AU-DESSUS de .logo-initial, qui n'est qu'un repli */
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    padding: 0;
  }
  .logo-initial {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: rgb(220 38 38);
    background: rgb(255 255 255 / 0.95);
  }
  .logo-chip:hover { z-index: 99 !important; }
  /* Les logos pointent vers la meme page que le lien texte a droite. */
  a.logo-chip { cursor: pointer; text-decoration: none; }

  /* Distinction (bourse, prix) : ambre plutot que rouge, pour qu'elle se detache
     du reste de la carte sans concurrencer l'accent du site. */
  .award-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 13px;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    color: #92400e;
    background: rgb(245 158 11 / 0.14);
    border: 1px solid rgb(245 158 11 / 0.4);
    transition: background 0.18s ease, border-color 0.18s ease;
  }
  :global(.dark) .award-badge {
    color: #fbbf24;
    background: rgb(245 158 11 / 0.1);
    border-color: rgb(245 158 11 / 0.32);
  }
  a.award-badge:hover { background: rgb(245 158 11 / 0.24); border-color: rgb(245 158 11 / 0.6); }
  .logo-single { transition: transform 0.22s ease; }
  .logo-single:hover { transform: scale(1.08); }
  @media (prefers-reduced-motion: reduce) {
    .logo-chip { transition: none; }
  }
</style>
